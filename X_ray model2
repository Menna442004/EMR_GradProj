 img_tensor = val_transform(img_pil)\n\n    # Build metadata tensor\n    meta_tensor = torch.tensor([\n        patient_age / 100.0,\n        1.0 if patient_gender == 'F' else 0.0,\n        1.0 if view_position == 'AP' else 0.0\n    ], dtype=torch.float32)\n\n    # Predict\n    with torch.no_grad():\n        logits = model(\n            img_tensor.unsqueeze(0).to(device),\n            meta_tensor.unsqueeze(0).to(device)\n        )\n    probs = torch.sigmoid(logits)[0].cpu().numpy()\n\n    # Apply thresholds\n    predictions = {\n        DISEASE_LABELS[i]: {\n            'probability': float(probs[i]),\n            'predicted':   bool(probs[i] >= thresh[i]),\n            'threshold':   thresh[i]\n        }\n        for i in range(NUM_CLASSES)\n    }\n\n    # Grad-CAM for top predicted class\n    top_cls   = int(np.argmax(probs))\n    cam       = gradcam.generate(img_tensor, meta_tensor, top_cls)\n    overlay, orig, heatmap = overlay_gradcam(img_tensor, cam, alpha=0.45)\n\n    # ── Plot ─────────────────────────────────────────────────────────────────\n    fig, axes = plt.subplots(1, 3, figsize=(14, 5))\n    axes[0].imshow(orig, cmap='bone')\n    axes[0].set_title('Original X-Ray (CLAHE)', fontweight='bold')\n    axes[0].axis('off')\n\n    axes[1].imshow(overlay)\n    axes[1].set_title(f'Grad-CAM → {DISEASE_LABELS[top_cls]}', fontweight='bold')\n    axes[1].axis('off')\n\n    # Probability bar chart\n    sorted_idx   = np.argsort(probs)[::-1]\n    sorted_probs = probs[sorted_idx]\n    sorted_names = [DISEASE_LABELS[i] for i in sorted_idx]\n    bar_colors   = ['#e74c3c' if probs[i] >= thresh[i] else '#95a5a6'\n                    for i in sorted_idx]\n    bars = axes[2].barh(range(NUM_CLASSES), sorted_probs,\n                        color=bar_colors, edgecolor='white')\n    axes[2].set_yticks(range(NUM_CLASSES))\n    axes[2].set_yticklabels(sorted_names, fontsize=8)\n    axes[2].set_xlim([0, 1])\n    axes[2].axvline(0.5, color='gray', linestyle='--', alpha=0.5)\n    axes[2].set_title('Disease Probabilities\\n(Red = Predicted Positive)', fontweight='bold')\n    axes[2].set_xlabel('Probability')\n\n    plt.suptitle(\n        f'Patient: Age={patient_age}, Gender={patient_gender}, View={view_position}',\n        fontweight='bold', fontsize=12\n    )\n    plt.tight_layout()\n    plt.savefig('/kaggle/working/demo_prediction.png', bbox_inches='tight')\n    plt.show()\n\n    # Print results\n    print('\\n' + '═' * 50)\n    print('  DIAGNOSIS REPORT')\n    print('═' * 50)\n    positive = [(k, v) for k, v in predictions.items() if v['predicted']]\n    if positive:\n        print('  ⚠️  DETECTED CONDITIONS:')\n        for name, info in sorted(positive, key=lambda x: -x[1]['probability']):\n            print(f'     • {name:<22s}  Prob: {info[\"probability\"]:.3f}  (threshold: {info[\"threshold\"]:.2f})')\n    else:\n        print('  ✅  No pathology detected above threshold')\n    print('═' * 50)\n\n    return predictions\n\n\n# ── Example: predict on first test image ─────────────────────────────────────\nsample_row = test_df.iloc[0]\nresult = predict_single_image(\n    image_path    = sample_row['image_path'],\n    patient_age   = int(sample_row['Patient Age']),\n    patient_gender= sample_row['Patient Gender'],\n    view_position = sample_row['View Position']\n)\n\n# Ensure grayscale images are converted to RGB\nimg = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"8f38728f-a009-4f28-b4c1-a48bbf5ae571","cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}