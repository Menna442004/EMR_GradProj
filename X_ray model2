:"<Figure size 1920x600 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":6},{"id":"a421a3ef-8107-4e12-86e6-85d32f9e3833","cell_type":"markdown","source":"## 3.  Patient-Level Data Split","metadata":{}},{"id":"2281da8e-d767-4d26-a6e1-083c5cc37f4d","cell_type":"code","source":"# Patient-level split: critical to prevent data leakage\n# All images from same patient go to same split\nunique_patients = df['Patient ID'].unique()\n\ntrain_pts, temp_pts = train_test_split(unique_patients, test_size=0.25, random_state=SEED)\nval_pts, test_pts   = train_test_split(temp_pts, test_size=0.40, random_state=SEED)\n\ntrain_df = df[df['Patient ID'].isin(train_pts)].reset_index(drop=True)\nval_df   = df[df['Patient ID'].isin(val_pts)].reset_index(drop=True)\ntest_df  = df[df['Patient ID'].isin(test_pts)].reset_index(drop=True)\n\nprint(f'Train: {len(train_df):>7,} images | {len(train_pts):,} patients')\nprint(f'Val  : {len(val_df):>7,} images | {len(val_pts):,} patients')\nprint(f'Test : {len(test_df):>7,} images | {len(test_pts):,} patients')\n\n# Verify no overlap\nassert len(set(train_pts) & set(val_pts)) == 0, 'Train/Val patient overlap!'\nassert len(set(train_pts) & set(test_pts)) == 0, 'Train/Test patient overlap!'\nprint('✅ No patient overlap between splits')","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:30.934751Z","iopub.execute_input":"2026-04-04T13:41:30.935053Z","iopub.status.idle":"2026-04-04T13:41:31.012636Z","shell.execute_reply.started":"2026-04-04T13:41:30.935029Z","shell.execute_reply":"2026-04-04T13:41:31.011827Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Train:  84,432 images | 23,101 patients\nVal  :  16,222 images | 4,620 patients\nTest :  11,450 images | 3,081 patients\n✅ No patient overlap between splits\n","output_type":"stream"}],"execution_count":7},{"id":"ab731e19-fd6a-4865-836f-309c005191fe","cell_type":"markdown","source":"## 4.  Class Imbalance Strategy","metadata":{}},{"id":"e04b8147-20d9-440b-86e8-da94630cffa6","cell_type":"code","source":"# ─── Compute Class Weights for Focal Loss & BCE ───────────────────────────────\ncounts_train = train_df[DISEASE_LABELS].sum().values.astype(float)\ntotal = len(train_df)\n\n# Effective Number of Samples weighting (better than simple log weighting)\n# From paper: \"Class-Balanced Loss Based on Effective Number of Samples\"\nbeta = 0.999\neffective_num = 1.0 - np.power(beta, counts_train)\nclass_weights = (1.0 - beta) / effective_num\nclass_weights = class_weights / class_weights.sum() * NUM_CLASSES  # normalize\n\n# Also compute pos_weight for BCEWithLogitsLoss: ratio of neg/pos per class\npos_weight = (total - counts_train) / (counts_train + 1e-5)\n\nprint('Class weights (higher = rarer disease):')\nfor label, w, pw in zip(DISEASE_LABELS, class_weights, pos_weight):\n    print(f'  {label:<20s}: eff_weight={w:.3f}  pos_weight={pw:.1f}')\n\npos_weight_tensor = torch.tensor(pos_weight, dtype=torch.float32).to(device)","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:31.013767Z","iopub.execute_input":"2026-04-04T13:41:31.014347Z","iopub.status.idle":"2026-04-04T13:41:31.371417Z","shell.execute_reply.started":"2026-04-04T13:41:31.014323Z","shell.execute_reply":"2026-04-04T13:41:31.370739Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Class weights (higher = rarer disease):\n  Atelectasis         : eff_weight=0.661  pos_weight=8.7\n  Cardiomegaly        : eff_weight=0.764  pos_weight=41.1\n  Effusion            : eff_weight=0.661  pos_weight=7.5\n  Infiltration        : eff_weight=0.661  pos_weight=4.7\n  Mass                : eff_weight=0.668  pos_weight=17.7\n  Nodule              : eff_weight=0.666  pos_weight=16.6\n  Pneumonia           : eff_weight=0.997  pos_weight=76.6\n  Pneumothorax        : eff_weight=0.673  pos_weight=19.8\n  Consolidation       : eff_weight=0.682  pos_weight=23.4\n  Edema               : eff_weight=0.808  pos_weight=48.5\n  Emphysema           : eff_weight=0.772  pos_weight=42.6\n  Fibrosis            : eff_weight=0.928  pos_weight=66.8\n  Pleural_Thickening  : eff_weight=0.715  pos_weight=31.7\n  Hernia              : eff_weight=4.344  pos_weight=510.7\n","output_type":"stream"}],"execution_count":8},{"id":"6ddf2d09-cd73-4d50-ae6c-6296b60d4be2","cell_type":"code","source":"sample_weights = []\nfor _, row in train_df[DISEASE_LABELS].iterrows():\n    active = row.values.astype(bool)\n    if active.any():\n        w = class_weights[active].max()\n    else:\n        w = 0.05  # very low weight for No Finding\n    sample_weights.append(float(w))\n\nsampler = WeightedRandomSampler(\n    weights=sample_weights,\n    num_samples=len(sample_weights),\n    replacement=True\n)\nprint(f'✅ Sampler ready. Min: {min(sample_weights):.4f} | Max: {max(sample_weights):.4f}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-04T13:41:31.372400Z","iopub.execute_input":"2026-04-04T13:41:31.372702Z","iopub.status.idle":"2026-04-04T13:41:33.946583Z","shell.execute_reply.started":"2026-04-04T13:41:31.372669Z","shell.execute_reply":"2026-04-04T13:41:33.945898Z"}},"outputs":[{"name":"stdout","text":"✅ Sampler ready. Min: 0.0500 | Max: 4.3438\n","output_type":"stream"}],"execution_count":9},{"id":"f06beed7-0680-4a3c-bb48-f282651737c0","cell_type":"markdown","source":"## 5. Dataset & Augmentation Pipeline","metadata":{}},{"id":"6b2c0ea3-0488-46a0-83e3-eb0c7d63fb8c","cell_type":"code","source":"# ─── CLAHE Preprocessing Function ────────────────────────────────────────────\ndef apply_clahe(img_path):\n    \"\"\"Apply CLAHE to enhance local contrast in chest X-rays.\"\"\"\n    img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)\n    if img is None:\n        img = np.zeros((224, 224), dtype=np.uint8)\n    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))\n    img = clahe.apply(img)\n    # Convert to 3-channel for pretrained models\n    img = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)\n    return Image.fromarray(img)\n\n\n# ─── Augmentation Transforms ─────────────────────────────────────────────────\nIMAGENET_MEAN = [0.485, 0.456, 0.406]\nIMAGENET_STD  = [0.229, 0.224, 0.225]\nIMG_SIZE = 224\n\ntrain_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE + 32, IMG_SIZE + 32)),\n    transforms.RandomCrop(IMG_SIZE),                         # random crop\n    transforms.RandomHorizontalFlip(p=0.5),                  # medically valid for chest X-rays\n    transforms.RandomRotation(degrees=10),                   # small rotation\n    transforms.RandomAffine(degrees=0, translate=(0.05, 0.05), scale=(0.9, 1.1)),\n    transforms.ColorJitter(brightness=0.2, contrast=0.2),    # lighting variation\n    transforms.RandomGrayscale(p=0.05),\n    transforms.ToTensor(),\n    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n    transforms.RandomErasing(p=0.2, scale=(0.02, 0.1)),      # CutOut regularization\n])\n\nval_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n])\n\nprint('✅ Augmentation pipeline ready')","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:33.947628Z","iopub.execute_input":"2026-04-04T13:41:33.948165Z","iopub.status.idle":"2026-04-04T13:41:33.957741Z","shell.execute_reply.started":"2026-04-04T13:41:33.948138Z","shell.execute_reply":"2026-04-04T13:41:33.957145Z"},"trusted":true},"outputs":[{"name":"stdout","text":"✅ Augmentation pipeline ready\n","output_type":"stream"}],"execution_count":10},{"id":"7e3da4f2-55f0-4d6c-94c6-177e6b563b12","cell_type":"code","source":"# ─── Dataset Class ────────────────────────────────────────────────────────────\nclass ChestXRayDataset(Dataset):\n    def __init__(self, dataframe, transform=None, use_clahe=True):\n        self.df = dataframe.reset_index(drop=True)\n        self.transform = transform\n        self.use_clahe = use_clahe\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n\n        # Image: CLAHE → PIL → Transforms\n        img_path = row['image_path']\n        if self.use_clahe:\n            img = apply_clahe(img_path)\n        else:\n            img = Image.open(img_path).convert('RGB')\n\n        if self.transform:\n            img = self.transform(img)\n\n        # Metadata: age (normalized), gender, view position\n        meta = torch.tensor([\n            float(row['Normalized_Age']),\n            float(row['Gender_Code']),\n            float(row['View_Code'])\n        ], dtype=torch.float32)\n\n        # Labels\n        labels = torch.tensor(\n            row[DISEASE_LABELS].values.astype('float32'),\n            dtype=torch.float32\n        )\n        return img, meta, labels\n\n\n# # ─── DataLoaders ──────────────────────────────────────────────────────────────\n# BATCH_SIZE = 32\n# NUM_WORKERS = 2\n\n# train_dataset = ChestXRayDataset(train_df, transform=train_transform, use_clahe=True)\n# val_dataset   = ChestXRayDataset(val_df,   transform=val_transform,   use_clahe=True)\n# test_dataset  = ChestXRayDataset(test_df,  transform=val_transform,   use_clahe=True)\n\n# # train_loader = DataLoader(persistent_workers=True, train_dataset, batch_size=BATCH_SIZE,\n# #                           sampler=sampler, num_workers=NUM_WORKERS,\n# #                           pin_memory=True, drop_last=True)\n# train_loader = DataLoader(\n#     train_dataset,\n#     batch_size=BATCH_SIZE,\n#     shuffle=True,   # IMPORTANT: shuffle instead of sampler\n#     num_workers=2,\n#     pin_memory=True,\n#     persistent_workers=True\n# )\n# val_loader   = DataLoader(persistent_workers=True, val_dataset,   batch_size=BATCH_SIZE,\n#                           shuffle=False,  num_workers=NUM_WORKERS,\n#                           pin_memory=True)\n# test_loader  = DataLoader(persistent_workers=True, test_dataset,  batch_size=BATCH_SIZE,\n#                           shuffle=False,  num_workers=NUM_WORKERS,\n#                           pin_memory=True)\n\n# print(f'Train batches: {len(train_loader):,}')\n# print(f'Val   batches: {len(val_loader):,}')\n# print(f'Test  batches: {len(test_loader):,}')\n# # Ensure grayscale images are converted to RGB\n\n","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:33.958844Z","iopub.execute_input":"2026-04-04T13:41:33.959087Z","iopub.status.idle":"2026-04-04T13:41:33.980549Z","shell.execute_reply.started":"2026-04-04T13:41:33.959066Z","shell.execute_reply":"2026-04-04T13:41:33.979744Z"},"trusted":true},"outputs":[],"execution_count":11},{"id":"99b46a7b-0500-4d39-9c40-034648f23efa","cell_type":"code","source":"# ─── DataLoaders ──────────────────────────────────────────────────────────────\nBATCH_SIZE = 32\nNUM_WORKERS = 2\n\ntrain_dataset = ChestXRayDataset(train_df, transform=train_transform, use_clahe=True)\nval_dataset   = ChestXRayDataset(val_df,   transform=val_transform,   use_clahe=True)\ntest_dataset  = ChestXRayDataset(test_df,  transform=val_transform,   use_clahe=True)\n\ntrain_loader = DataLoader(\n    train_dataset,\n    batch_size=BATCH_SIZE,\n    sampler=sampler,          # ← was shuffle=True\n    num_workers=NUM_WORKERS,\n    pin_memory=True,\n    persistent_workers=True,\n    drop_last=True\n)\n\nval_loader = DataLoader(\n    val_dataset,\n    batch_size=BATCH_SIZE,\n    shuffle=False,\n    num_workers=NUM_WORKERS,\n    pin_memory=True,\n    persistent_workers=True\n)\n\ntest_loader = DataLoader(\n    test_dataset,\n    batch_size=BATCH_SIZE,\n    shuffle=False,\n    num_workers=NUM_WORKERS,\n    pin_memory=True,\n    persistent_workers=True\n)\n\nprint(f'Train batches: {len(train_loader):,}')\nprint(f'Val   batches: {len(val_loader):,}')\nprint(f'Test  batches: {len(test_loader):,}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-04T13:41:33.981602Z","iopub.execute_input":"2026-04-04T13:41:33.982838Z","iopub.status.idle":"2026-04-04T13:41:34.016188Z","shell.execute_reply.started":"2026-04-04T13:41:33.982810Z","shell.execute_reply":"2026-04-04T13:41:34.015443Z"}},"outputs":[{"name":"stdout","text":"Train batches: 2,638\nVal   batches: 507\nTest  batches: 358\n","output_type":"stream"}],"execution_count":12},{"id":"c886950d-9a3d-4829-8ca7-4172bdea87e0","cell_type":"code","source":"# ─── Visualize Sample Augmented Images ───────────────────────────────────────\ndef denormalize(tensor, mean=IMAGENET_MEAN, std=IMAGENET_STD):\n    t = tensor.clone().cpu()\n    for c, (m, s) in enumerate(zip(mean, std)):\n        t[c] = t[c] * s + m\n    return t.permute(1, 2, 0).numpy().clip(0, 1)\n\nsample_imgs, sample_meta, sample_labels = next(iter(train_loader))\n\nfig, axes = plt.subplots(2, 5, figsize=(15, 7))\nfor i, ax in enumerate(axes.flatten()):\n    if i >= 10: break\n    ax.imshow(denormalize(sample_imgs[i]), cmap='bone')\n    active = [DISEASE_LABELS[j] for j in range(NUM_CLASSES) if sample_labels[i][j] == 1]\n    title = '\\n'.join(active) if active else 'No Finding'\n    ax.set_title(title, fontsize=7)\n    ax.axis('off')\nplt.suptitle('Sample Augmented Training Images (with CLAHE)', fontweight='bold', y=1.01)\nplt.tight_layout()\nplt.savefig('sample_images.png', bbox_inches='tight')\nplt.show()\n# Ensure grayscale images are converted to RGB\n","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:34.017232Z","iopub.execute_input":"2026-04-04T13:41:34.017609Z","iopub.status.idle":"2026-04-04T13:41:38.181864Z","shell.execute_reply.started":"2026-04-04T13:41:34.017577Z","shell.execute_reply":"2026-04-04T13:41:38.180876Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1800x840 with 10 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":13},{"id":"8c5a275c-d3c7-4519-8276-b90aa1667f23","cell_type":"markdown","source":"## 6. Model Architecture: DenseNet121 + Multimodal","metadata":{}},{"id":"d4102789-fbfd-41d8-b9da-56e79bff4709","cell_type":"code","source":"# ─── Focal Loss: Better than BCE for Heavy Imbalance ─────────────────────────\nclass FocalBCELoss(nn.Module):\n    \"\"\"\n    Focal Loss for multi-label classification.\n    Reduces loss contribution from easy negatives → focuses on hard positives.\n    gamma=2 is standard. alpha balances pos/neg via pos_weight.\n    \"\"\"\n    def __init__(self, pos_weight=None, gamma=2.0, reduction='mean'):\n        super().__init__()\n        self.gamma = gamma\n        self.pos_weight = pos_weight\n        self.reduction = reduction\n\n    def forward(self, logits, targets):\n        bce = F.binary_cross_entropy_with_logits(\n            logits, targets,\n            pos_weight=self.pos_weight,\n            reduction='none'\n        )\n        probs = torch.sigmoid(logits)\n        p_t = probs * targets + (1 - probs) * (1 - targets)\n        focal_weight = (1.0 - p_t) ** self.gamma\n        loss = focal_weight * bce\n        return loss.mean() if self.reduction == 'mean' else loss.sum()","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:38.184184Z","iopub.execute_input":"2026-04-04T13:41:38.184565Z","iopub.status.idle":"2026-04-04T13:41:38.191490Z","shell.execute_reply.started":"2026-04-04T13:41:38.184518Z","shell.execute_reply":"2026-04-04T13:41:38.190930Z"},"trusted":true},"outputs":[],"execution_count":14},{"id":"4962d545-de1a-461c-9c24-1628d9b4f2d0","cell_type":"code","source":"# ─── DenseNet121 + Multimodal Head ────────────────────────────────────────────\n# DenseNet121 is the backbone used in CheXNet (Rajpurkar et al.),\n# the seminal paper achieving radiologist-level chest X-ray diagnosis.\n\nclass CheXNetMultimodal(nn.Module):\n    def __init__(self, num_classes, meta_dim=3, dropout_rate=0.4):\n        super().__init__()\n\n        # ── Backbone: DenseNet121 pretrained on ImageNet ──────────────────────\n        base = densenet121(weights=DenseNet121_Weights.IMAGENET1K_V1)\n        self.features = base.features       # CNN feature extractor\n        self.avgpool  = nn.AdaptiveAvgPool2d((1, 1))\n        dense_out     = base.classifier.in_features  # 1024\n\n        # ── Metadata branch: small MLP for age/gender/view ───────────────────\n        self.meta_branch = nn.Sequential(\n            nn.Linear(meta_dim, 32),\n            nn.ReLU(),\n            nn.Dropout(0.2),\n            nn.Linear(32, 16),\n            nn.ReLU(),\n        )\n\n        # ── Classifier head ───────────────────────────────────────────────────\n        fusion_dim = dense_out + 16\n        self.classifier = nn.Sequential(\n            nn.BatchNorm1d(fusion_dim),\n            nn.Dropout(dropout_rate),\n            nn.Linear(fusion_dim, 512),\n            nn.ReLU(),\n            nn.Dropout(dropout_rate / 2),\n            nn.Linear(512, num_classes)\n        )\n\n        # Grad-CAM hooks\n        self._gradients = None\n        self._activations = None\n\n    # ── Grad-CAM hook registration ────────────────────────────────────────────\n    def _save_gradient(self, grad):\n        self._gradients = grad\n\n    def forward(self, img, meta):\n        # Feature extraction\n        x = self.features(img)\n        if x.requires_grad:  \n            # ✅ skip hook during Phase 1 (frozen)\n            x.register_hook(self._save_gradient)\n        self._activations = x\n\n        x_pooled = self.avgpool(x)\n        x_flat   = torch.flatten(x_pooled, 1)  # (B, 1024)\n\n        # Metadata path\n        m = self.meta_branch(meta)  # (B, 16)\n\n        # Fusion\n        fused = torch.cat([x_flat, m], dim=1)\n        return self.classifier(fused)\n\n\n# ─── Differential Learning Rates: slower for backbone, faster for head ───────\nmodel = CheXNetMultimodal(num_classes=NUM_CLASSES).to(device)\n\n# Freeze ALL backbone layers initially, only train head\nfor param in model.features.parameters():\n    param.requires_grad = False\n\ntotal_params     = sum(p.numel() for p in model.parameters())\ntrainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\nprint(f'Total params: {total_params:,}')\nprint(f'Trainable params (head only): {trainable_params:,}')","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:38.192365Z","iopub.execute_input":"2026-04-04T13:41:38.192770Z","iopub.status.idle":"2026-04-04T13:41:38.913420Z","shell.execute_reply.started":"2026-04-04T13:41:38.192749Z","shell.execute_reply":"2026-04-04T13:41:38.911802Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Downloading: \"https://download.pytorch.org/models/densenet121-a639ec97.pth\" to /root/.cache/torch/hub/checkpoints/densenet121-a639ec97.pth\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 30.8M/30.8M [00:00<00:00, 124MB/s] \n","output_type":"stream"},{"name":"stdout","text":"Total params: 7,496,766\nTrainable params (head only): 542,910\n","output_type":"stream"}],"execution_count":15},{"id":"218ff50c-f9d3-4ccc-acf7-252bb816b734","cell_type":"markdown","source":"## 7.  Training: Phase 1 (Warm-up — Train Head Only)","metadata":{}},{"id":"aff489e7-e7a0-4088-aa57-ad6c4a5f2784","cell_type":"code","source":"# ─── Loss & Optimizer ─────────────────────────────────────────────────────────\ncriterion = FocalBCELoss(pos_weight=pos_weight_tensor, gamma=2.0)\n\noptimizer = torch.optim.AdamW(\n    filter(lambda p: p.requires_grad, model.parameters()),\n    lr=1e-3, weight_decay=1e-4\n)\n\n# Mixed precision scaler\nscaler = GradScaler()\n\nWARMUP_EPOCHS = 3\nwarmup_scheduler = torch.optim.lr_scheduler.OneCycleLR(\n    optimizer, max_lr=1e-3,\n    steps_per_epoch=len(train_loader),\n    epochs=WARMUP_EPOCHS,\n    pct_start=0.3\n)\n\n# ─── Training Helper Functions ────────────────────────────────────────────────\ndef train_one_epoch(model, loader, optimizer, criterion, scaler, scheduler=None):\n    model.train()\n    total_loss = 0.0\n    for imgs, metas, labels in tqdm(loader, leave=False, desc='  Training'):\n        imgs   = imgs.to(device, non_blocking=True)\n        metas  = metas.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n\n        optimizer.zero_grad(set_to_none=True)\n\n        with autocast():\n            logits = model(imgs, metas)\n            loss   = criterion(logits, labels)\n\n        scaler.scale(loss).backward()\n        scaler.unscale_(optimizer)\n        nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)  # gradient clipping\n        scaler.step(optimizer)\n        scaler.update()\n\n        if scheduler is not None:\n            scheduler.step()\n\n        total_loss += loss.item()\n    return total_loss / len(loader)\n\n\n@torch.no_grad()\ndef evaluate(model, loader, criterion):\n    model.eval()\n    total_loss = 0.0\n    all_probs  = []\n    all_labels = []\n\n    for imgs, metas, labels in tqdm(loader, leave=False, desc='  Evaluating'):\n        imgs   = imgs.to(device, non_blocking=True)\n        metas  = metas.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n\n        with autocast():\n            logits = model(imgs, metas)\n            loss   = criterion(logits, labels)\n\n        total_loss += loss.item()\n        probs = torch.sigmoid(logits).cpu().numpy()\n        all_probs.append(probs)\n        all_labels.append(labels.cpu().numpy())\n\n    all_probs  = np.vstack(all_probs)\n    all_labels = np.vstack(all_labels)\n    avg_loss   = total_loss / len(loader)\n\n    # Per-class AUC-ROC (skip classes with no positive samples)\n    aucs = []\n    for i in range(all_labels.shape[1]):\n        if all_labels[:, i].sum() > 0:\n            aucs.append(roc_auc_score(all_labels[:, i], all_probs[:, i]))\n        else:\n            aucs.append(0.0)\n    mean_auc = np.mean([a for a in aucs if a > 0])\n\n    return avg_loss, mean_auc, aucs, all_probs, all_labels\n\n\nprint('✅ Training functions ready')","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:38.914702Z","iopub.execute_input":"2026-04-04T13:41:38.915105Z","iopub.status.idle":"2026-04-04T13:41:38.929606Z","shell.execute_reply.started":"2026-04-04T13:41:38.915072Z","shell.execute_reply":"2026-04-04T13:41:38.929011Z"},"trusted":true},"outputs":[{"name":"stdout","text":"✅ Training functions ready\n","output_type":"stream"}],"execution_count":16},{"id":"357071fe-3b44-4229-a774-586560710549","cell_type":"code","source":"# ─── Phase 1: Train Head Only (Warm-up) ───────────────────────────────────────\nprint('=' * 60)\nprint('PHASE 1: Warm-up — training head only (backbone frozen)')\nprint('=' * 60)\n\nhistory = defaultdict(list)\n\nfor epoch in range(1, WARMUP_EPOCHS + 1):\n    train_loss = train_one_epoch(\n        model, train_loader, optimizer, criterion, scaler, warmup_scheduler\n    )\n    val_loss, val_auc, _, _, _ = evaluate(model, val_loader, criterion)\n\n    history['train_loss'].append(train_loss)\n    history['val_loss'].append(val_loss)\n    history['val_auc'].append(val_auc)\n\n    lr = optimizer.param_groups[0]['lr']\n    print(f'[Warmup Epoch {epoch:2d}/{WARMUP_EPOCHS}] '\n          f'Train Loss: {train_loss:.4f} | '\n          f'Val Loss: {val_loss:.4f} | '\n          f'Val AUC: {val_auc:.4f} | '\n          f'LR: {lr:.2e}')\n\nprint('Phase 1 complete!')","metadata":{"execution":{"iopub.status.busy":"2026-04-04T13:41:38.930698Z","iopub.execute_input":"2026-04-04T13:41:38.930989Z"},"trusted":true},"outputs":[{"name":"stdout","text":"============================================================\nPHASE 1: Warm-up — training head only (backbone frozen)\n============================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  Training:   0%|          | 0/2638 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":""}},"metadata":{}},{"name":"stderr","text":"libpng warning: iCCP: profile 'ICC Profile': 'GRAY': Gray color space not permitted on RGB PNG\nlibpng warning: iCCP: profile 'ICC Profile': 'GRAY': Gray color space not permitted on RGB PNG\nlibpng warning: iCCP: profile 'ICC Profile': 'GRAY': Gra