ptim.AdamW([\n    {'params': model.features.parameters(),  'lr': 1e-5},\n    {'params': model.meta_branch.parameters(),'lr': 1e-4},\n    {'params': model.classifier.parameters(), 'lr': 1e-4},\n], weight_decay=1e-4)\n\nFINETUNE_EPOCHS = 15\n\n# Cosine Annealing with Warm Restarts: prevents plateau overfitting\nscheduler = torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(\n    optimizer, T_0=5, T_mult=2, eta_min=1e-7\n)\n\n# Early stopping params\nbest_loss        = float('inf')\npatience         = 7\npatience_counter = 0\nSAVE_PATH        = '/kaggle/working/best_chexnet_multimodal.pth'\n\nprint('=' * 60)\nprint('PHASE 2: Fine-tuning — full model with differential LRs')\nprint('=' * 60)\n\nfor epoch in range(1, FINETUNE_EPOCHS + 1):\n    train_loss = train_one_epoch(\n        model, train_loader, optimizer, criterion, scaler\n    )\n    val_loss, val_auc, val_aucs, _, _ = evaluate(model, val_loader, criterion)\n    scheduler.step(epoch)\n\n    history['train_loss'].append(train_loss)\n    history['val_loss'].append(val_loss)\n    history['val_auc'].append(val_auc)\n\n    lr_backbone = optimizer.param_groups[0]['lr']\n    print(f'[FT Epoch {epoch:2d}/{FINETUNE_EPOCHS}] '\n          f'Train Loss: {train_loss:.4f} | '\n          f'Val Loss: {val_loss:.4f} | '\n          f'Val AUC: {val_auc:.4f} | '\n          f'LR: {lr_backbone:.2e}')\n\n    # Save best model on lowest validation loss (stable & consistent with literature)\n    if val_loss < best_loss:\n        best_loss = val_loss\n        patience_counter = 0\n        torch.save({\n            'epoch': epoch,\n            'model_state_dict': model.state_dict(),\n            'optimizer_state_dict': optimizer.state_dict(),\n            'val_loss': best_loss,\n            'val_auc': val_auc,\n            'disease_labels': DISEASE_LABELS\n        }, SAVE_PATH)\n        print(f'  💾 Saved best model (Val Loss: {best_loss:.4f} | Val AUC: {val_auc:.4f})')\n    else:\n        patience_counter += 1\n        if patience_counter >= patience:\n            print(f'⏹  Early stopping triggered at epoch {epoch} (patience={patience})')\n            break\n\nprint(f'\\n🏆 Best Validation Loss: {best_loss:.4f}')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"a1306f86-bb04-47b9-a428-953ecb5cf439","cell_type":"markdown","source":"## 9.  Training Curves & Metrics","metadata":{}},{"id":"db0715a6-5813-49d6-ae38-feb0d6daa566","cell_type":"code","source":"# ─── Training Curves ──────────────────────────────────────────────────────────\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\nepochs_range = range(1, len(history['train_loss']) + 1)\n\n# ── derive best_auc from history (works whether saved on loss or auc) ─────────\nbest_auc = max(history['val_auc']) if history['val_auc'] else 0.0\n\n# Loss\naxes[0].plot(epochs_range, history['train_loss'], 'b-o', label='Train Loss', ms=4)\naxes[0].plot(epochs_range, history['val_loss'],   'r-o', label='Val Loss',   ms=4)\naxes[0].axvline(WARMUP_EPOCHS, color='gray', linestyle='--', alpha=0.5, label='Phase 2 start')\naxes[0].set_title('Training & Validation Loss', fontweight='bold')\naxes[0].set_xlabel('Epoch')\naxes[0].set_ylabel('Focal BCE Loss')\naxes[0].legend()\n\n# AUC\naxes[1].plot(epochs_range, history['val_auc'], 'g-o', label='Val Mean AUC', ms=4)\naxes[1].axhline(best_auc, color='orange', linestyle='--', label=f'Best AUC = {best_auc:.4f}')\naxes[1].axvline(WARMUP_EPOCHS, color='gray', linestyle='--', alpha=0.5)\naxes[1].set_title('Validation Mean AUC-ROC', fontweight='bold')\naxes[1].set_xlabel('Epoch')\naxes[1].set_ylabel('AUC-ROC')\naxes[1].set_ylim([0.5, 1.0])\naxes[1].legend()\n\nplt.tight_layout()\nplt.savefig('training_curves.png', bbox_inches='tight')\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"8c7c15c4-899b-4226-b098-23e188f9a68c","cell_type":"markdown","source":"## 10. 🧪 Test Set Evaluation","metadata":{}},{"id":"2f461373-1c97-453b-8310-2d292bfdb5b7","cell_type":"code","source":"# ─── Load Best Model & Evaluate on Test Set ───────────────────────────────────\ncheckpoint = torch.load(SAVE_PATH, map_location=device)\nmodel.load_state_dict(checkpoint['model_state_dict'])\nprint(f\"Loaded best model from epoch {checkpoint['epoch']} | Val Loss: {checkpoint['val_loss']:.4f} | Val AUC: {checkpoint['val_auc']:.4f}\")\n\ntest_loss, test_auc, test_aucs, test_probs, test_labels = evaluate(\n    model, test_loader, criterion\n)\n\nprint(f'\\nTest Loss: {test_loss:.4f}')\nprint(f'Test Mean AUC: {test_auc:.4f}')\nprint('\\nPer-class AUC-ROC:')\nprint('-' * 40)\nfor label, auc in zip(DISEASE_LABELS, test_aucs):\n    bar = '█' * int(auc * 30)\n    print(f'{label:<20s}: {auc:.4f}  {bar}')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"e4c17c35-c939-4489-80a8-8d89f72ba238","cell_type":"code","source":"# ─── Per-Class AUC-ROC Bar Chart ──────────────────────────────────────────────\nsorted_idx = np.argsort(test_aucs)\nsorted_labels = [DISEASE_LABELS[i] for i in sorted_idx]\nsorted_aucs   = [test_aucs[i] for i in sorted_idx]\n\ncolors = ['#e74c3c' if a < 0.7 else '#f39c12' if a < 0.8 else '#2ecc71' for a in sorted_aucs]\n\nplt.figure(figsize=(10, 7))\nbars = plt.barh(sorted_labels, sorted_aucs, color=colors, edgecolor='white')\nplt.axvline(0.7, color='gray', linestyle='--', alpha=0.7, label='AUC = 0.7')\nplt.axvline(0.8, color='navy', linestyle='--', alpha=0.7, label='AUC = 0.8')\nplt.axvline(test_auc, color='purple', linestyle='-', linewidth=2,\n            label=f'Mean AUC = {test_auc:.3f}')\nfor bar, val in zip(bars, sorted_aucs):\n    plt.text(val + 0.005, bar.get_y() + bar.get_height()/2,\n             f'{val:.3f}', va='center', fontsize=9)\nplt.xlim([0.5, 1.0])\nplt.xlabel('AUC-ROC', fontsize=12)\nplt.title('Per-Class AUC-ROC on Test Set', fontweight='bold', fontsize=13)\nplt.legend()\nplt.tight_layout()\nplt.savefig('per_class_auc.png', bbox_inches='tight')\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"c99d1bb6-742d-47ce-805a-f123b618d675","cell_type":"code","source":"# ─── Threshold Optimization: Maximize F1 per class ───────────────────────────\nfrom sklearn.metrics import f1_score as sklearn_f1\n\noptimal_thresholds = []\nfor i in range(NUM_CLASSES):\n    best_t, best_f1 = 0.5, 0.0\n    for t in np.arange(0.1, 0.9, 0.05):\n        preds = (test_probs[:, i] >= t).astype(int)\n        if preds.sum() == 0:\n            continue\n        f1 = sklearn_f1(test_labels[:, i], preds, zero_division=0)\n        if f1 > best_f1:\n            best_f1 = f1\n            best_t  = t\n    optimal_thresholds.append(best_t)\n\nprint('Optimal thresholds per class:')\nfor label, t in zip(DISEASE_LABELS, optimal_thresholds):\n    print(f'  {label:<20s}: {t:.2f}')\n\n# Apply optimal thresholds\ntest_preds_opt = np.zeros_like(test_probs)\nfor i, t in enumerate(optimal_thresholds):\n    test_preds_opt[:, i] = (test_probs[:, i] >= t).astype(int)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"2964cfda-a407-490c-86e3-a4c04bffaf5e","cell_type":"code","source":"# ─── Classification Report ────────────────────────────────────────────────────\nprint('\\n' + '=' * 70)\nprint('CLASSIFICATION REPORT (Optimal Thresholds)')\nprint('=' * 70)\nprint(classification_report(\n    test_labels, test_preds_opt,\n    target_names=DISEASE_LABELS,\n    zero_division=0\n))\n\n# Summary table\nf1_scores = [sklearn_f1(test_labels[:, i], test_preds_opt[:, i], zero_division=0)\n             for i in range(NUM_CLASSES)]\nsummary_df = pd.DataFrame({\n    'Disease': DISEASE_LABELS,\n    'AUC-ROC': [f'{a:.4f}' for a in test_aucs],\n    'F1 Score': [f'{f:.4f}' for f in f1_scores],\n    'Threshold': [f'{t:.2f}' for t in optimal_thresholds]\n}).set_index('Disease')\nprint(summary_df.to_string())","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"1e79bda7-b1be-49ff-a733-8eba0b60eaa8","cell_type":"code","source":"# ─── Multi-label Confusion Matrices ───────────────────────────────────────────\ncms = multilabel_confusion_matrix(test_labels, test_preds_opt)\n\nfig, axes = plt.subplots(3, 5, figsize=(18, 12))\nfor i, (ax, label) in enumerate(zip(axes.flatten(), DISEASE_LABELS)):\n    tn, fp, fn, tp = cms[i].ravel()\n    cm_display = np.array([[tn, fp], [fn, tp]])\n    sns.heatmap(cm_display, annot=True, fmt='d', ax=ax,\n                cmap='Blues', cbar=False,\n                xticklabels=['Pred Neg', 'Pred Pos'],\n                yticklabels=['True Neg', 'True Pos'])\n    auc = test_aucs[i]\n    ax.set_title(f'{label}\\nAUC={auc:.3f}', fontsize=8, fontweight='bold')\n    ax.tick_params(labelsize=7)\n\n# Hide unused subplots\nfor ax in axes.flatten()[NUM_CLASSES:]:\n    ax.set_visible(False)\n\nplt.suptitle('Per-Class Confusion Matrices (Test Set)', fontweight='bold', y=1.01, fontsize=14)\nplt.tight_layout()\nplt.savefig('confusion_matrices.png', bbox_inches='tight')\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"96706c03-3c88-4522-811a-968c0255d45d","cell_type":"markdown","source":"## 11.  Explainability: Grad-CAM Heatmaps","metadata":{}},{"id":"4954ea48-6de2-4687-8ed6-667bc25419c9","cell_type":"code","source":"# ─── Grad-CAM Implementation ──────────────────────────────────────────────────\nclass GradCAM:\n    \"\"\"\n    Gradient-weighted Class Activation Mapping for DenseNet121.\n    Produces heatmaps showing which regions influenced the model's prediction.\n    \"\"\"\n    def __init__(self, model, target_layer):\n        self.model = model\n        self.target_layer = target_layer\n        self.gradients   = None\n        self.activations = None\n        self._register_hooks()\n\n    def _register_hooks(self):\n        def forward_hook(module, input, output):\n            self.activations = output.detach()\n\n        def backward_hook(module, grad_input, grad_output):\n            self.gradients = grad_output[0].detach()\n\n        self.target_layer.register_forward_hook(forward_hook)\n        self.target_layer.register_full_backward_hook(backward_hook)\n\n    def generate(self, img_tensor, meta_tensor, class_idx):\n        self.model.eval()\n        img_tensor  = img_tensor.unsqueeze(0).to(device)\n        meta_tensor = meta_tensor.unsqueeze(0).to(device)\n\n        # Forward pass\n        logits = self.model(img_tensor, meta_tensor)\n        self.model.zero_grad()\n\n        # Backward pass for target class\n        score = logits[0, class_idx]\n        score.backward()\n\n        # Global average pooling of gradients\n        pooled_grads = self.gradients.mean(dim=[2, 3], keepdim=True)  # (1, C, 1, 1)\n        cam = (pooled_grads * self.activations).sum(dim=1).squeeze()  # (H, W)\n        cam = F.relu(cam)\n\n        # Normalize to [0, 1]\n        cam -= cam.min()\n        if cam.max() > 0:\n            cam /= cam.max()\n\n        return cam.cpu().numpy()\n\n\ndef overlay_gradcam(img_tensor, cam, alpha=0.5):\n    \"\"\"Overlay CAM heatmap on the original image.\"\"\"\n    # Denormalize image\n    img_np = denormalize(img_tensor)\n\n    # Resize CAM to image size\n    cam_resized = cv2.resize(cam, (IMG_SIZE, IMG_SIZE))\n    heatmap = cv2.applyColorMap(\n        (cam_resized * 255).astype(np.uint8), cv2.COLORMAP_JET\n    )\n    heatmap = cv2.cvtColor(heatmap, cv2.COLOR_BGR2RGB) / 255.0\n\n    overlay = alpha * heatmap + (1 - alpha) * img_np\n    return overlay.clip(0, 1), img_np, heatmap\n\n\n# Target the last dense block of DenseNet121\ntarget_layer = model.features.denseblock4.denselayer16.conv2\ngradcam = GradCAM(model, target_layer)\n\nprint('✅ Grad-CAM initialized on DenseBlock4 Layer16')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"5fbc1d80-5b04-4c70-b90c-3f9c13dac8f3","cell_type":"code","source":"# ─── Grad-CAM Visualization: Top Predicted Diseases ──────────────────────────\ndef visualize_gradcam_grid(dataset, gradcam, num_samples=5, threshold=0.3):\n    \"\"\"\n    Show Grad-CAM heatmaps for samples with disease predictions.\n    Each row = one sample; columns = Original | Heatmap | Overlay + disease bars\n    \"\"\"\n    samples_shown = 0\n    fig_rows = []\n\n    for idx in range(min(300, len(dataset))):\n        img, meta, true_labels = dataset[idx]\n        if true_labels.sum() == 0:\n            continue  # skip No Finding\n\n        # Get predictions\n        with torch.no_grad():\n            logits = model(\n                img.unsqueeze(0).to(device),\n                meta.unsqueeze(0).to(device)\n            )\n        probs = torch.sigmoid(logits)[0].cpu().numpy()\n        top_class = np.argmax(probs)\n\n        if probs[top_class] < threshold:\n            continue\n\n        # Generate CAM for top class\n        cam = gradcam.generate(img, meta, top_class)\n        overlay, orig, heatmap = overlay_gradcam(img, cam)\n\n        fig_rows.append((orig, heatmap, overlay, probs, true_labels.numpy(), top_class))\n        samples_shown += 1\n        if samples_shown >= num_samples:\n            break\n\n    # Plot\n    fig, axes = plt.subplots(len(fig_rows), 4, figsize=(16, 4 * len(fig_rows)))\n    if len(fig_rows) == 1:\n        axes = axes[np.newaxis, :]\n\n    for row_idx, (orig, heatmap, overlay, probs, true_lbls, top_cls) in enumerate(fig_rows):\n        # Original\n        axes[row_idx, 0].imshow(orig, cmap='bone')\n        axes[row_idx, 0].set_title('Original (CLAHE)', fontsize=9, fontweight='bold')\n        axes[row_idx, 0].axis('off')\n\n        # Heatmap\n        axes[row_idx, 1].imshow(heatmap)\n        axes[row_idx, 1].set_title('Grad-CAM Heatmap', fontsize=9, fontweight='bold')\n        axes[row_idx, 1].axis('off')\n\n        # Overlay\n        axes[row_idx, 2].imshow(overlay)\n        target_name = DISEASE_LABELS[top_cls]\n        axes[row_idx, 2].set_title(f'Overlay\\nTarget: {target_name}', fontsize=9, fontweight='bold')\n        axes[row_idx, 2].axis('off')\n\n        # Prediction bars\n        ax_bar = axes[row_idx, 3]\n        y_pos = np.arange(NUM_CLASSES)\n        bar_colors = ['#e74c3c' if true_lbls[i] == 1 else '#3498db'\n                      for i in range(NUM_CLASSES)]\n        ax_bar.barh(y_pos, probs, color=bar_colors, alpha=0.8)\n        ax_bar.set_yticks(y_pos)\n        ax_bar.set_yticklabels(DISEASE_LABELS, fontsize=7)\n        ax_bar.set_xlim([0, 1])\n        ax_bar.axvline(0.5, color='gray', linestyle='--', alpha=0.5)\n        ax_bar.set_title('Predicted Probs\\n(Red=GT Positive)', fontsize=9, fontweight='bold')\n\n    plt.suptitle('Grad-CAM Explainability: Model Attention on Chest X-Rays',\n                 fontweight='bold', fontsize=13, y=1.01)\n    plt.tight_layout()\n    plt.savefig('gradcam_results.png', bbox_inches='tight')\n    plt.show()\n\n\nvisualize_gradcam_grid(test_dataset, gradcam, num_samples=5)\n# Ensure grayscale images are converted to RGB\nimg = cv2.cvtColor(img, cv2.COLOR_GRAY2RGB)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"722d64d0-b074-44c2-af9d-daaac9a67e03","cell_type":"code","source":"# ─── Grad-CAM for Each Disease Class ──────────────────────────────────────────\n# Find one positive example per disease and visualize its CAM\n\ndef find_positive_example(dataset, disease_idx, max_search=500):\n    for i in range(min(max_search, len(dataset))):\n        img, meta, labels = dataset[i]\n        if labels[disease_idx] == 1:\n            return img, meta, labels\n    return None\n\n\nn_cols = 4\nn_rows = (NUM_CLASSES + n_cols - 1) // n_cols\nfig, axes = plt.subplots(n_rows, n_cols, figsize=(16, 4 * n_rows))\n\nfor cls_idx, label in enumerate(DISEASE_LABELS):\n    ax = axes[cls_idx // n_cols][cls_idx % n_cols]\n    result = find_positive_example(test_dataset, cls_idx)\n\n    if result is None:\n        ax.text(0.5, 0.5, f'{label}\\n(No example found)',\n                ha='center', va='center', transform=ax.transAxes)\n        ax.axis('off')\n        continue\n\n    img, meta, labels = result\n    cam = gradcam.generate(img, meta, cls_idx